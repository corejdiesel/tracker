# Copy to .env.local (gitignored) to enable the sync engine.
#
# VITE_NEON_DSN — the same Neon connection string as ../.env.local's
# NEON_DSN. Bundled into the built app at compile time (Vite inlines
# VITE_-prefixed vars), which is acceptable here only because this is a
# single-operator app you build and run yourself — never distribute a build
# with this baked in to anyone else.
VITE_NEON_DSN=

# VITE_USER_ID — your account's id from public.users. Printed when you ran
# ../scripts/create-user.mjs; if you don't have it handy:
#   NEON_DSN="..." node ../scripts/whoami.mjs you@example.com
VITE_USER_ID=

# VITE_OLLAMA_VISION_MODEL — optional. Enables periodic-screenshot session
# summarization while the timer runs (see src/ai/session-summary.ts): every
# 5 minutes, a screenshot is described by a *local* vision model running
# under Ollama (http://localhost:11434 — https://ollama.com) and
# immediately discarded — only the description is kept — and at Stop the
# descriptions are combined into a draft work-log note you review before
# saving. Deliberately local-only, no cloud fallback: screenshots may show
# client work or HMRC/MTD screens, so nothing gets sent anywhere.
#
# Pull a model first, then set its tag here. Two known-good options:
#   ollama pull moondream      # ~1.7GB, needs ~4GB free RAM, any Mac
#   ollama pull qwen2-vl:2b    # ~2.4GB, needs ~6-8GB free RAM, better at
#                               # reading on-screen text; Chinese-developed
#                               # (Alibaba) but runs fully offline here
#
# Leave blank to skip screen capture entirely; the timer works fine
# without it. If Ollama isn't running when a capture is due, that one
# frame just fails (shown as "Last capture failed") rather than falling
# back to any cloud API.
VITE_OLLAMA_VISION_MODEL=
