# Neon — connection string from the Neon console (Dashboard → Connect).
# Must be the pooled connection string (contains "-pooler" in the host) with
# sslmode=require. Used server-side only, over HTTPS via
# @neondatabase/serverless — never exposed to the browser.
NEON_DSN=

# Session signing key for login cookies (HS256 JWT via `jose`). Generate one
# with: openssl rand -base64 32
# Must be at least 32 characters. Rotating it signs everyone out.
AUTH_SECRET=

# Never commit .env.local. Nothing secret belongs in a NEXT_PUBLIC_ variable.
