# Neon — the app_user role's connection string, NOT the project owner's
# (neondb_owner). Neon's owner role has the BYPASSRLS attribute, which skips
# every RLS policy in this schema regardless of FORCE ROW LEVEL SECURITY —
# confirmed on the live database, see db/migrations/0004_app_role.sql. After
# running scripts/migrate-neon.mjs against a fresh database (with the owner
# DSN), run scripts/set-app-role-password.mjs (also owner DSN) once — it
# prints the app_user connection string that belongs here.
NEON_DSN=

# Session signing key for login cookies (HS256 JWT via `jose`). Generate one
# with: openssl rand -base64 32
# Must be at least 32 characters. Rotating it signs everyone out.
AUTH_SECRET=

# Never commit .env.local. Nothing secret belongs in a NEXT_PUBLIC_ variable.
